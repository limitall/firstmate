# The operational home lives in the checkout, exactly as it does in the Linux
# firstmate repo, so these four are ignored here for the same reason.
config/
data/
projects/
state/

# Written by bin/fm-setup.ps1: the home this checkout resolves to when no
# profile and no environment variable supply one. Per-machine, never shared.
.fm-home
# Where this machine's captain chose to keep their work. Local, like .fm-home,
# and for the same reason: it names a path that exists only here.
.fm-workspace

# Transfer artifacts. A `git bundle` is how a branch reaches the captain's
# Windows laptop over a tunnel with no shared remote; it is a one-off carrier,
# never source. One was committed by accident once.
*.bundle
